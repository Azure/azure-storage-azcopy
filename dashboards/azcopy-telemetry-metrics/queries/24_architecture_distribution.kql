// Visual: Pie chart
customEvents
| where name startswith 'azcopy.'
| where timestamp between (_startTime .. _endTime)
// Host fields are on job.started; schema 4 omits them from job.finished.
| where name == 'azcopy.job.started'
| extend Value = tostring(customDimensions.HostArch)
| extend Value = iif(isempty(Value), 'unknown', Value)
| summarize Attempts = count() by Value
| order by Attempts desc