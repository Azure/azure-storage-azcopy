// Visual: Table
customEvents
| where name startswith 'azcopy.'
// Schema 4 omits a zero source_objects_under_1_mib from job.finished; count it as 0.
| extend customMeasurements = iff(tostring(customDimensions.SchemaVersion) == '4' and isnotempty(tostring(customDimensions.JobStatus)),
    bag_merge(customMeasurements, dynamic({'azcopy.source_objects_under_1_mib': 0})), customMeasurements)
| mv-expand MetricName = bag_keys(customMeasurements)
| extend name = tostring(MetricName)
| extend value = todouble(customMeasurements[name])
| project-away MetricName
| where timestamp between (_startTime .. _endTime)
| where name in ('azcopy.source_objects_under_1_mib', 'azcopy.source_objects_under_1_mib_ratio_pct', 'azcopy.source_max_directory_depth')
| summarize SampleSize = count(), Average = avg(value), P50 = percentile(value, 50), P95 = percentile(value, 95), Maximum = max(value) by Metric = name
| project Metric, SampleSize, Average = round(Average, 2), P50 = round(P50, 2), P95 = round(P95, 2), Maximum
| order by Metric asc