customEvents
| where timestamp between (_startTime .. _endTime)
| where name == 'azcopy.job.finished'
| where tostring(customDimensions.SchemaVersion) in ('1', '2', '3', '4')
| extend Value = strcat(tostring(customDimensions.SourceType), tostring(customDimensions.DestType))
| extend Value = iif(isempty(Value), 'unknown', Value)
| distinct Value
| order by Value asc
| project Label = Value, Value
