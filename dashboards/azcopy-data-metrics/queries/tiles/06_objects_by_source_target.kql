// Visual: Bar chart
let QueryStart = _startTime;
let QueryEnd = _endTime;
{{ENRICHED_FINISHED_JOBS}}
{{ENRICHMENT_FILTERS}}
FilteredFinishedJobs
| extend SourceTargetPair = strcat(SourceType, ' -> ', DestType)
| summarize CompletedObjects = sum(ObjectsCompleted) by SourceTargetPair
| project SourceTargetPair, CompletedObjects
| order by CompletedObjects desc
