// Visual: Bar chart
let QueryStart = _startTime;
let QueryEnd = _endTime;
{{ENRICHED_FINISHED_JOBS}}
{{ENRICHMENT_FILTERS}}
FilteredFinishedJobs
| extend SourceTargetPair = strcat(SourceType, ' -> ', DestType)
| summarize BytesTransferred = sum(BytesTransferred) by SourceTargetPair
| project SourceTargetPair, DataTB = round(BytesTransferred / 1000000000000.0, 3)
| order by DataTB desc
