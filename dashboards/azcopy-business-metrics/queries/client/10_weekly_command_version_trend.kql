// Visual: Stacked column chart
// X column: timestamp; Y: EstimatedAttempts; Series: Command
customEvents
| where name startswith 'azcopy.'
| mv-expand MetricName = bag_keys(customMeasurements)
| extend name = tostring(MetricName)
| extend value = todouble(customMeasurements[name])
| project-away MetricName
| where timestamp between (_startTime .. _endTime)
| where name in ('azcopy.job.finished', 'azcopy.command.invoked')
| extend
    Command = tostring(customDimensions.Command),
    Version = tostring(coalesce(customDimensions.AzCopyVersion, customDimensions.ServiceVersion)),
    SamplingRate = todouble(customDimensions.SamplingRate)
| extend Weight = iif(SamplingRate > 0.0 and SamplingRate <= 1.0, 1.0 / SamplingRate, 1.0)
| summarize
    ObservedInvocations = count(),
    EstimatedInvocations = sum(Weight)
  by Week = startofweek(timestamp), Command, Version
| project
    timestamp = Week,
    Command = iif(isempty(Command), 'unknown', Command),
    Version = iif(isempty(Version), 'unknown', Version),
    ObservedInvocations,
    EstimatedAttempts = round(EstimatedInvocations, 0)
| order by timestamp asc, EstimatedAttempts desc