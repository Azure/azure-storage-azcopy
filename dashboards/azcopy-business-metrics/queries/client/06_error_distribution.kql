// Visual: Bar chart
// Category axis: Error; Value: EstimatedAttempts
customEvents
| where name startswith 'azcopy.'
| mv-expand MetricName = bag_keys(customMeasurements)
| extend name = tostring(MetricName)
| extend value = todouble(customMeasurements[name])
| project-away MetricName
| where timestamp between (_startTime .. _endTime)
| where tostring(customDimensions.SchemaVersion) in ('2', '3')
| where name == 'azcopy.job.finished'
| extend
    ErrorCategory = tostring(customDimensions.JobErrorCategory),
    ErrorCode = tostring(customDimensions.JobErrorCode),
    FailureErrorCodes = tostring(customDimensions.FailureErrorCodes),
    SamplingRate = todouble(customDimensions.SamplingRate)
| where isnotempty(ErrorCategory) or isnotempty(ErrorCode)
| extend
    Weight = iif(SamplingRate > 0.0 and SamplingRate <= 1.0, 1.0 / SamplingRate, 1.0),
    Error = strcat(iif(isempty(ErrorCategory), 'unknown', ErrorCategory), ' / ', iif(isempty(ErrorCode), 'unknown', ErrorCode))
| summarize
    ObservedAttempts = count(),
    EstimatedAttempts = sum(Weight),
    TransferCodeExamples = make_set_if(FailureErrorCodes, isnotempty(FailureErrorCodes), 5)
  by Error
| top 20 by EstimatedAttempts desc
| project Error, ObservedAttempts, EstimatedAttempts = round(EstimatedAttempts, 0), TransferCodeExamples