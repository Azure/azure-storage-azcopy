// Visual: Multi stat
// Schema v2 and v3 are accepted. Other schemas are visible here but excluded
// from the business-metric queries.
let RequiredFinishMetrics = dynamic(['azcopy.average_storage_http_attempt_e2e_ms', 'azcopy.avg_iops', 'azcopy.bytes_enumerated', 'azcopy.bytes_expected', 'azcopy.bytes_over_wire', 'azcopy.bytes_transferred', 'azcopy.enumeration_phase_duration_seconds', 'azcopy.failure_error_other_count', 'azcopy.folder_properties_completed', 'azcopy.folder_properties_failed', 'azcopy.folder_properties_scheduled', 'azcopy.folder_properties_skipped', 'azcopy.hardlinks_converted_scheduled', 'azcopy.job_duration_seconds', 'azcopy.network_error_attempt_count', 'azcopy.network_error_pct', 'azcopy.objects_completed', 'azcopy.objects_failed', 'azcopy.objects_scheduled', 'azcopy.objects_skipped', 'azcopy.percent_complete', 'azcopy.regular_files_scheduled', 'azcopy.server_busy_503_count', 'azcopy.server_busy_iops_count', 'azcopy.server_busy_other_count', 'azcopy.server_busy_pct', 'azcopy.server_busy_throughput_count', 'azcopy.source_average_object_size_bytes', 'azcopy.source_bytes_scanned', 'azcopy.source_max_directory_depth', 'azcopy.source_object_size_p50_bytes_approx', 'azcopy.source_object_size_p90_bytes_approx', 'azcopy.source_object_size_p95_bytes_approx', 'azcopy.source_objects_scanned', 'azcopy.source_objects_under_1_mib', 'azcopy.source_objects_under_1_mib_ratio_pct', 'azcopy.storage_http_attempt_count', 'azcopy.symlinks_scheduled', 'azcopy.transfer_phase_duration_seconds', 'azcopy.transfers_completed', 'azcopy.transfers_failed', 'azcopy.transfers_skipped', 'azcopy.transfers_total']);
customEvents
| where timestamp between (_startTime .. _endTime)
| where name in ('azcopy.job.started', 'azcopy.job.finished')
| extend
    InvocationID = tostring(customDimensions.InvocationID),
    JobID = tostring(coalesce(customDimensions.JobID, customDimensions.RunID)),
    SchemaVersionValue = tostring(customDimensions.SchemaVersion),
    CommandValue = tostring(customDimensions.Command),
    FromToValue = tostring(customDimensions.FromTo),
    SourceTypeValue = tostring(customDimensions.SourceType),
    DestTypeValue = tostring(customDimensions.DestType),
    ReportedDurationValue = todouble(customMeasurements['azcopy.job_duration_seconds']),
    FinishMetricCountValue = array_length(bag_keys(customMeasurements)),
    RequiredMetricKeys = set_union(RequiredFinishMetrics,
        iff(tostring(customDimensions.SummaryCounterScope) == 'job-cumulative', dynamic([]), dynamic(['azcopy.job_throughput_mbps', 'azcopy.transfer_phase_throughput_mbps'])),
        iff(tostring(customDimensions.SourceScopeCountsStatus) == 'incomplete', dynamic([]), dynamic(['azcopy.containers_scanned', 'azcopy.containers_touched', 'azcopy.buckets_scanned', 'azcopy.buckets_touched'])))
| extend MissingFinishMetricCountValue = array_length(set_difference(RequiredMetricKeys, coalesce(bag_keys(customMeasurements), dynamic([]))))
| extend AttemptKey = iif(
    isnotempty(InvocationID) and isnotempty(JobID),
    strcat(InvocationID, '/', JobID),
    strcat('missing-id:', tostring(itemId)))
| summarize
    StartEvents = countif(name == 'azcopy.job.started'),
    FinishEvents = countif(name == 'azcopy.job.finished'),
    StartTime = minif(timestamp, name == 'azcopy.job.started'),
    FinishTime = maxif(timestamp, name == 'azcopy.job.finished'),
    SchemaVersionCount = dcount(SchemaVersionValue),
    SchemaVersion = take_any(SchemaVersionValue),
    ReportedDurationSeconds = max(ReportedDurationValue),
    FinishMetricCount = maxif(FinishMetricCountValue, name == 'azcopy.job.finished'),
    MissingRequiredFinishMetrics = maxif(MissingFinishMetricCountValue, name == 'azcopy.job.finished'),
    MissingRequiredDimensionRows = countif(
        isempty(InvocationID) or isempty(JobID) or isempty(CommandValue) or
        isempty(FromToValue) or isempty(SourceTypeValue) or isempty(DestTypeValue))
  by AttemptKey
| extend
    ObservedDurationSeconds = iif(
        StartEvents > 0 and FinishEvents > 0,
        todouble(datetime_diff('millisecond', FinishTime, StartTime)) / 1000.0,
        real(null)),
    InvalidSchema = SchemaVersionCount != 1 or SchemaVersion !in ('1', '2', '3'),
    LifecycleAnomaly = StartEvents != 1 or FinishEvents != 1,
    MissingRequiredFields = MissingRequiredDimensionRows > 0,
    IncompleteFinishMetricSet = FinishEvents > 0 and MissingRequiredFinishMetrics > 0
| extend
    TimingAnomaly = StartEvents == 1 and FinishEvents == 1 and ObservedDurationSeconds < 0.0,
    DurationMismatch = StartEvents == 1 and FinishEvents == 1 and
        isnotnull(ReportedDurationSeconds) and ReportedDurationSeconds >= 0.0 and
        abs(ObservedDurationSeconds - ReportedDurationSeconds) >
            max_of(60.0, ReportedDurationSeconds * 0.2)
| extend Accepted =
    not(InvalidSchema) and not(LifecycleAnomaly) and not(MissingRequiredFields) and
    not(IncompleteFinishMetricSet) and not(TimingAnomaly) and not(DurationMismatch)
| summarize
    ObservedAttempts = count(),
    AcceptedAttempts = countif(Accepted),
    InvalidSchemaAttempts = countif(InvalidSchema),
    LifecycleSuspectAttempts = countif(LifecycleAnomaly),
    TimingSuspectAttempts = countif(TimingAnomaly or DurationMismatch),
    MissingRequiredFieldAttempts = countif(MissingRequiredFields),
    IncompleteFinishMetricAttempts = countif(IncompleteFinishMetricSet)
| extend AcceptedRatePercent = round(100.0 * AcceptedAttempts / iif(ObservedAttempts > 0, ObservedAttempts, 1), 2)
| mv-expand MetricValue = pack_array(
    bag_pack('Metric', 'Observed attempts', 'Value', ObservedAttempts),
    bag_pack('Metric', 'Accepted attempts', 'Value', AcceptedAttempts),
    bag_pack('Metric', 'Accepted rate (%)', 'Value', AcceptedRatePercent),
    bag_pack('Metric', 'Invalid schema', 'Value', InvalidSchemaAttempts),
    bag_pack('Metric', 'Lifecycle suspects', 'Value', LifecycleSuspectAttempts),
    bag_pack('Metric', 'Timing suspects', 'Value', TimingSuspectAttempts),
    bag_pack('Metric', 'Missing required fields', 'Value', MissingRequiredFieldAttempts),
    bag_pack('Metric', 'Incomplete finish metrics', 'Value', IncompleteFinishMetricAttempts))
| project
    Metric = tostring(MetricValue.Metric),
    Value = todouble(MetricValue.Value)