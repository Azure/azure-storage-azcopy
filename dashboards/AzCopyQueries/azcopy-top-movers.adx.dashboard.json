  "queries": [
    {
      "id": "a2c00000-0000-4000-8000-000000000100",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_FilterValues() | where FilterName == 'Customer' | project FilterValue, FilterLabel | order by FilterLabel asc"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000101",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_FilterValues() | where FilterName == 'Command' | project FilterValue, FilterLabel | order by FilterLabel asc"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000102",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_FilterValues() | where FilterName == 'SourceType' | project FilterValue, FilterLabel | order by FilterLabel asc"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000103",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_FilterValues() | where FilterName == 'TargetType' | project FilterValue, FilterLabel | order by FilterLabel asc"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000200",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_topN"
      ],
      "text": "AzCopy_TopMovers(datetime(1970-01-01), now() + 1m, _topN, dynamic(['$__all']), dynamic(['$__all']), dynamic(['$__all']), dynamic(['$__all'])) | project Customer, DataTransferredGB = DataTransferred / 1e9"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000201",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_topN",
        "_source",
        "_target"
      ],
      "text": "AzCopy_TopMovers(startofmonth(now()), now() + 1m, _topN, dynamic(['$__all']), dynamic(['$__all']), _source, _target) | project Customer, DataTransferredGB = DataTransferred / 1e9"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000202",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_topN",
        "_source",
        "_target"
      ],
      "text": "AzCopy_TopMovers(startofmonth(datetime_add('month', -1, now())), startofmonth(now()), _topN, dynamic(['$__all']), dynamic(['$__all']), _source, _target) | project Customer, DataTransferredGB = DataTransferred / 1e9"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000203",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_topN"
      ],
      "text": "AzCopy_TopMovers(AzCopy_PreviousSemesterStart(), AzCopy_CurrentSemesterStart(), _topN, dynamic(['$__all']), dynamic(['$__all']), dynamic(['$__all']), dynamic(['$__all'])) | project Customer, DataTransferredGB = DataTransferred / 1e9"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000204",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_topN",
        "_source",
        "_target"
      ],
      "text": "AzCopy_TopMovers(AzCopy_CurrentSemesterStart(), now() + 1m, _topN, dynamic(['$__all']), dynamic(['$__all']), _source, _target) | project Customer, DataTransferredGB = DataTransferred / 1e9"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000205",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_topN",
        "_customer",
        "_command",
        "_source",
        "_target"
      ],
      "text": "AzCopy_TopMovers(_startTime, _endTime, _topN, _customer, _command, _source, _target) | project Customer, DataTransferredGB = DataTransferred / 1e9"
    },
    {
      "id": "a2c00000-0000-4000-8000-000000000206",
      "dataSource": {
        "dataSourceId": "a2c00000-0000-4000-8000-000000000001",
        "kind": "inline"
