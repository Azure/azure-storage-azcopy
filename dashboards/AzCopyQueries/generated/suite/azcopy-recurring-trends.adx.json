      },
      "usedVariables": [],
      "text": "AzCopy_DashboardFilters() | where FilterName == 'SubscriptionId' | project text=FilterLabel, value=FilterValue",
      "id": "a2c10000-0000-4000-8003-000000000102"
    },
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_DashboardFilters() | where FilterName == 'SourceType' | project text=FilterLabel, value=FilterValue",
      "id": "a2c10000-0000-4000-8003-000000000103"
    },
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_DashboardFilters() | where FilterName == 'TargetType' | project text=FilterLabel, value=FilterValue",
      "id": "a2c10000-0000-4000-8003-000000000104"
    },
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_customer",
        "_subscription",
        "_source",
        "_target"
      ],
      "text": "AzCopy_RecurringSummary(_startTime, _endTime, _customer, _subscription, _source, _target) | project RecurringCustomers",
      "id": "a2c10000-0000-4000-8003-000000000203"
    },
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_customer",
        "_subscription",
        "_source",
        "_target"
      ],
      "text": "AzCopy_RecurringSummary(_startTime, _endTime, _customer, _subscription, _source, _target) | project DataTransferredGB = BytesTransferred / 1e9",
      "id": "a2c10000-0000-4000-8003-000000000201"
    },
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
        "kind": "inline"
      },
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_customer",
        "_subscription",
        "_source",
        "_target"
      ],
      "text": "AzCopy_RecurringSummary(_startTime, _endTime, _customer, _subscription, _source, _target) | project AverageActiveMonths = iff(isnull(AverageActiveMonths), 'N/A', tostring(round(AverageActiveMonths, 1)))",
      "id": "a2c10000-0000-4000-8003-000000000204"
    },
