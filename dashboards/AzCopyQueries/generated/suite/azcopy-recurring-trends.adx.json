  "queries": [
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
        "kind": "inline"
      },
      "usedVariables": [],
      "text": "AzCopy_DashboardFilters() | where FilterName == 'Customer' | project text=FilterLabel, value=FilterValue",
      "id": "a2c10000-0000-4000-8003-000000000101"
    },
    {
      "dataSource": {
        "dataSourceId": "a2c10000-0000-4000-8003-000000000001",
